# Copia este archivo como .env y ajusta tus credenciales locales.
# El .env NUNCA se commitea. Las variables se validan al arrancar (config/env.validation.ts).

NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL.
# Supabase: Connect > Session pooler (la conexion directa solo funciona por IPv6).
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_USER=postgres.<id-del-proyecto>
#   DB_NAME=postgres
#   DB_SSL=true
# PostgreSQL local: los valores de abajo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=marina
DB_SSL=false
# Opcional: certificado de Supabase (Database Settings > SSL) para verificar el servidor.
# DB_SSL_CA=./prod-supabase.cer
# Opcional: conexiones simultaneas a la base (por defecto 10).
# DB_POOL_MAX=10

# Autenticacion
JWT_SECRET=cambiar-en-cada-entorno-minimo-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-en-cada-entorno-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
MAX_INTENTOS_FALLIDOS=5

# Integracion
FRONTEND_URL=http://localhost:5173
STORAGE_PATH=./storage/carteles

# Copia este archivo como .env y ajusta tus credenciales locales.
# El .env NUNCA se commitea. Las variables se validan al arrancar (config/env.validation.ts).

NODE_ENV=development
PORT=3000

# Base de datos: Supabase. En el proyecto pulsa Connect, pestana Connection String,
# metodo Session pooler. Copia la cadena y cambia [YOUR-PASSWORD] por la contrasena
# de la base (Project Settings > Database). El SSL se activa solo.
# No son las API keys (anon / service_role): esas sirven para la API REST de
# Supabase, no para conectarse a la base.
DATABASE_URL=postgresql://postgres.<id-del-proyecto>:<contrasena>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Alternativa sin DATABASE_URL (por ejemplo, PostgreSQL local):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=marina
# Opcional: DB_SSL=true|false fuerza el cifrado (por defecto, solo contra Supabase).
# Opcional: certificado de Supabase (Database Settings > SSL) para verificar el servidor.
# DB_SSL_CA=./prod-supabase.cer
# Opcional: conexiones simultaneas a la base (por defecto 10).
# DB_POOL_MAX=10

# Autenticacion
JWT_SECRET=cambiar-en-cada-entorno-minimo-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-en-cada-entorno-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
MAX_INTENTOS_FALLIDOS=5

# Integracion
FRONTEND_URL=http://localhost:5173
STORAGE_PATH=./storage/carteles

# Supabase Storage: fotos de criminales y carteles compartidos por todo el equipo.
# SUPABASE_URL es la Project URL (Project Settings > Data API).
# SUPABASE_SERVICE_ROLE_KEY es la llave SECRETA (Project Settings > API Keys:
# "secret" sb_secret_... o la "service_role" clasica). Nunca la anon ni la publishable.
# Si falta alguna de las dos, los archivos se guardan en STORAGE_PATH (disco local).
SUPABASE_URL=https://<id-del-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: nombre del bucket (se crea solo, privado).
# SUPABASE_STORAGE_BUCKET=marine-fleet
